{
  "name": "jobpilot-mcp",
  "version": "0.3.0",
  "description": "MCP server that lets AI assistants search jobs, match them to your resume, and track applications",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "jobpilot-mcp": "build/index.js"
  },
  "files": [
    "build",
    "public"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "web": "tsc && node --env-file-if-exists=.env build/web.js",
    "start:web": "node --env-file-if-exists=.env build/web.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "test": "tsc && node --test build/unit.test.js",
    "e2e": "tsc && node build/e2e.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "resume",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
