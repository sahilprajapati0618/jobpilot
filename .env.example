# Copy this file to .env and fill in the values. Never commit .env.

# Port for the web app (default 3000)
PORT=3000

# Public address of the site, used for Google's redirect URL.
# Local: http://localhost:3000   Deployed: https://your-app.onrender.com
PUBLIC_URL=http://localhost:3000

# "Continue with Google": create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where user accounts, resumes and applications are stored (default: ~/.jobpilot)
# JOBPILOT_DATA_DIR=

# Deployment only:
# HOST=0.0.0.0          listen on all interfaces
# NODE_ENV=production   send cookies over HTTPS only
# TRUST_PROXY=1         read the client IP from X-Forwarded-For (for login rate limiting)
